<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_glass"
    android:padding="14dp"
    android:gravity="center_horizontal">

    <!-- Header Row -->
    <RelativeLayout
        android:id="@+id/widget_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_cleaner_emblem"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_logo"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="@string/widget_title"
            android:textColor="#E6EDF5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_refresh_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh_widget"
            android:contentDescription="تحديث القياسات" />
    </RelativeLayout>

    <!-- RAM Metrics Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_ram_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%"
            android:textColor="#00E5A3"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_ram_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="متاح 2.4 GB • إجمالي 6.0 GB"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_ready"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- One-Tap Boost Button -->
    <Button
        android:id="@+id/widget_boost_button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_widget_button"
        android:text="@string/widget_boost_action"
        android:textColor="#003825"
        android:textSize="13sp"
        android:textStyle="bold"
        android:stateListAnimator="@null" />

</LinearLayout>
